- name: epy_block_0
  id: epy_block
  parameters:
    K: K
    Q: Q
    R: R
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.basic_block):\
      \  # other base classes are basic_block, decim_block, interp_block\n\n    def\
      \ __init__(self, K=4, Q=4, R=None):  # only default arguments here\n       \
      \ gr.basic_block.__init__(\n            self,\n            name='MCOZ Symbol\
      \ Generator', \n            in_sig=None,\n            out_sig=[np.complex64]\n\
      \        )\n        # if an attribute with the same name as a parameter is found,\n\
      \        # a callback is registered (properties work, too).\n        self.K\
      \ = K\n        self.Q = Q\n        self.R = np.sqrt(1 + np.sin(np.pi/K)) if\
      \ R is None else R\n        self.zero_geometry = self.codebook_con()\n\n   \
      \ def codebook_con(self):\n        Ri, Ro = self.R**(-1), self.R\n        theta\
      \ = 2 * np.pi / self.K\n        return [( Ri * np.exp(1j*theta*k), Ro * np.exp(1j*theta*k)\
      \ ) for k in range(self.K)]\n\n    def coeffCon(self, msg):\n        zeros =\
      \ np.array([self.zero_geometry[mk][msg[mk]]*np.exp(1j*np.pi*0/self.K) for mk\
      \ in range(self.K)])\n        N = self.K * 2\n        z = np.exp(2j * np.pi\
      \ * np.arange(N) / N)\n        X_Z = np.prod( z[:, None] - zeros[None, :], axis=1\
      \ )\n        return np.fft.fft(X_Z)[:self.K+1]/N  # increasing powers, monic\n\
      \n    def general_work(self, input_items, output_items):\n        msgTx = np.random.randint(0,\
      \ 2, self.K)\n        sigTx = self.coeffCon(msgTx)\n        sigPower = np.mean(np.abs(sigTx)**2)\n\
      \        sigTx /= np.sqrt(sigPower)\n        \n        output_items[0][:len(sigTx)]\
      \ = sigTx[:]\n        output_items[0][len(sigTx):] = np.zeros(len(output_items[0])-len(sigTx),\
      \ dtype=complex)\n        return len(output_items[0])"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('MCOZ Symbol Generator', 'blk', [('K', '4'), ('Q', '4'), ('R', 'None')],
      [], [('0', 'complex', 1)], '', ['K', 'Q', 'R'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [72, 376.0]
    rotation: 0
    state: enabled
- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\
      \  # other base classes are basic_block, decim_block, interp_block\n    \"\"\
      \"Embedded Python Block example - a simple multiply const\"\"\"\n\n    def __init__(self,\
      \ example_param=1.0):  # only default arguments here\n        \"\"\"arguments\
      \ to this function show up as parameters in GRC\"\"\"\n        gr.sync_block.__init__(\n\
      \            self,\n            name='MOCZ Receiver',   # will show up in GRC\n\
      \            in_sig=[np.complex64],\n            out_sig=[np.complex64]\n  \
      \      )\n        # if an attribute with the same name as a parameter is found,\n\
      \        # a callback is registered (properties work, too).\n        self.example_param\
      \ = example_param\n\n    def work(self, input_items, output_items):\n      \
      \  \"\"\"example: multiply with constant\"\"\"\n        output_items[0][:] =\
      \ input_items[0] * self.example_param\n        return len(output_items[0])\n"
    affinity: ''
    alias: ''
    comment: ''
    example_param: '1.0'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('MOCZ Receiver', 'blk', [('example_param', '1.0')], [('0', 'complex',
      1)], [('0', 'complex', 1)], 'Embedded Python Block example - a simple multiply
      const', ['example_param'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [240, 224.0]
    rotation: 0
    state: disabled
- name: epy_block_2
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\
      \  \n\n    def __init__(self, example_param=1.0):  \n        gr.sync_block.__init__(\n\
      \            self,\n            name='Huffman Energy Detector', \n         \
      \   in_sig=[np.complex64],\n            out_sig=[np.complex64]\n        )\n\
      \        self.example_param = example_param\n\n    def work(self, input_items,\
      \ output_items):\n        output_items[0][:] = input_items[0] * self.example_param\n\
      \        return len(output_items[0])\n"
    affinity: ''
