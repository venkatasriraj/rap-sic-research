- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\nimport csv\nimport\
      \ pmt\nimport random\n\nclass blk(gr.basic_block): \n\n    _AccessCode = [0xAA,\
      \ 0xAA, 0xAA, 0xAA]\n    _filler = [0xAA, 0xAA, 0xAB, 0xAB]\n    _defaultLambda\
      \ = [(1.0, 2)]\n    _packetSize = 24\n\n    def __init__(self, userId=1, slots=20,\
      \ packets=5, lambda_dist=None, activeProb=0.6):  \n        gr.sync_block.__init__(\n\
      \            self,\n            name='IRSA Frame Generator',   \n          \
      \  in_sig=None,\n            out_sig=None\n        )\n        self.message_port_register_out(pmt.intern(\"\
      out\"))\n        self.set_msg_handler(pmt.intern(\"out\"), self._handle_msg())\n\
      \        self.userId = userId\n        self.packets = packets\n        self.slots\
      \ = slots\n        self.frames = 0\n        self.sequenceNo = 0\n        self.activeProb\
      \ = activeProb\n        # self.distribution = lambda_dist if self.validate_lambda(lambda_dist)\
      \ else self._defaultLambda\n        self.distribution = self._defaultLambda\n\
      \n    def _handle_msg(self):\n        print(\"Start of this Block\")\n\n   \
      \ def frameGeneration(self):\n        self.frames += 1\n        if random.uniform(0,\
      \ 1) < self.activeProb:\n            print(\"Frame Skipped\")\n        else:\n\
      \            print(\"Packet will be transmitted\")\n            slotProb = random.uniform(0,\
      \ 1.0)\n            degree = [p for p, d in self.distribution if p > slotProb][0]\n\
      \            slotList = random.sample(range(1, self.slots+1), degree)\n    \
      \        packet = self.packetGen(slotList)\n        return None\n\n    def packetGen(self,\
      \ SLOTLIST):\n        \"\"\"\n        [Pilot Sequence[4B]| UserId[1B]| SequenceNo[1B]|\
      \ FrameNo[1B]| SlotList[2 * 1B]| Payload[15B]| ]\n        \"\"\"\n        if\
      \ self.sequenceNo >= self.packets:\n            return None\n        self.sequenceNo\
      \ += 1\n        seqNo = self.sequenceNo & 0xFF\n        uId = self.userId &\
      \ 0xFF\n        fId = self.frames & 0xFF\n        slotList = [s & 0xFF for s\
      \ in SLOTLIST]\n        header = np.concatenate((self._AccessCode, uId, seqNo,\
      \ fId, slotList), axis=None)\n        payloadSize = self._packetSize - len(header)\n\
      \        payload = np.random.randint(0, 255, payloadSize)\n        packet =\
      \ np.concatenate((header, payload))\n        return packet\n\n    def validate_lambda(self,\
      \ dist):\n        if not dist:\n            raise ValueError(\"Distribution\
      \ shouldn't be empty\")\n        prob = [p for p, d in dist]\n        if (prob[-1]\
      \ - 1.0) > 1e-6:\n            raise ValueError(f\"Distribution should end with\
      \ 1.0 but got {prob[-1]}\")\n        if prob != sorted(prob):\n            raise\
      \ ValueError(\"Distribution is not sorted\")"
    affinity: ''
    alias: ''
    comment: ''
    frames: '2'
    maxoutbuf: '0'
    minoutbuf: '0'
    slots: '20'
    userId: '1'
  states:
    _io_cache: ('IRSA Frame Generator', 'blk', [('userId', '1'), ('slots', '20'),
      ('frames', '2')], [], [('out', 'message', 1)], '', ['frames', 'slots', 'userId'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [88, 288.0]
    rotation: 0
    state: enabled
- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\n\
      \    def __init__(self, example_param=1.0):  \n        gr.sync_block.__init__(\n\
      \            self,\n            name='Burst Inserter',   \n            in_sig=[np.complex64],\n\
      \            out_sig=[np.complex64]\n        )\n        self.example_param =\
      \ example_param\n\n    def work(self, input_items, output_items):\n        output_items[0][:]\
      \ = input_items[0] * self.example_param\n        return len(output_items[0])\n"
    affinity: ''
    alias: ''
    comment: ''
    example_param: '1.0'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Burst Inserter', 'blk', [('example_param', '1.0')], [('0', 'complex',
      1)], [('0', 'complex', 1)], '', ['example_param'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [904, 288.0]
    rotation: 0
    state: enabled

connections:
- [blocks_throttle2_0, '0', epy_block_1, '0']
- [digital_constellation_modulator_0, '0', blocks_throttle2_0, '0']

